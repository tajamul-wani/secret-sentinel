{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Secret Sentinel: Run Tests",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Secret Sentinel: Scan Staged",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "secret_sentinel.cli",
        "--staged"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Secret Sentinel: Scan Repository",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "secret_sentinel.cli",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Secret Sentinel: Install Hook",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "secret_sentinel.cli",
        "--install-hook"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Secret Sentinel: Uninstall Hook",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "secret_sentinel.cli",
        "--uninstall-hook"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
